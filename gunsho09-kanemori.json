 "poems": [
  {
   "seq": "1",
   "text": "我君としごろ民をめぐみ國をおさめおはしますこと御",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "まつりごとかずおほくて山にのぼり水にたはぶれ給ふ",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "おほみあそびもみえざりき西はをぐら山の秋のもみぢ",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いたづらにその色をうしなひ東はむらさい野の春の梅",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "むなしうそのかげをうしなひきしのほとりみづきよう",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "子日してよの榮ゆへきためしにはけふの御幸をよには殘さん",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "道遠みゆきてはみねと山櫻こゝろをやりてけふは歸りぬ",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "花盛たのめし人もある物をかくさけりともつけすやあらまし",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "山櫻あくまてけふはみつるかな花ちるへくも風ふかぬよに",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "思ひつゝねつれはみえつ春の夜のまさしき夢に空しからすな",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "山城のこまのわたりをみてしかな瓜つくりけん人の垣ねを",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "天の原くもれはかなし人しれす賴む木のもと雨ふりしより",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "あさちふに秋の夕暮なく虫は我ことしたに物やかなしき",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あれはてゝ月もとまらぬ我宿に秋の木のはをかせそふきける",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "山かくれ消せぬ雪のかなしきは君まつの葉にかゝるなりけり",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "たよりあらはいかて都へ告けやらむけふ白川の關はこえぬと",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "恨めしき里のなゝれや君に我あはつの原のあはてかへれは",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "粟つ野のあはて歸れはせたの橋こひてかへれと思ふなるへし",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "世中を今はかきりと思ふには君こひしくやならむとすらん",
   "kana": "",
   "speaker": "",
   "page": 332,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "春霞たな引空は人しれす我身よりたつけふりなりけり",
   "kana": "",
   "speaker": "兼盛集",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "石まより出る泉そむせふなるむかしをこふる聲にやあるらし",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "同しくはつけてをこひん難波めの忍ひにのみはもえて渡らし",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "みぬ人の戀しき時はなのつから我のみならすだれもしるうん",
   "kana": "",
   "speaker": "君ノ",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "濵千鳥かひなかりけりつれもなき人のあたりは鳴わたれとも",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "なにせんに人をおかしと思ひけん戀する袖のやすからなくに",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あふことを今やとまつにかゝりてそ露の命の年もへにける",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "はかもなく落る淚をつゝみてそ人めもるとはいふへかりける",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "我戀はつゝ井の水となりならん心をくみて人はしるへく",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "ことのはゝ色やは見ゆるこむらさき深き心はねそめてそしる",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "さゝれ石の上もかくれぬ澤水の淺ましくのみみゆる君かな",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "谷河の岩まをわけて行水の音にのみやは聞わたるへき",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "我戀にくらへてしかな山河の岩まの波にかすをそへつゝ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "君を思ふかすにしとらはをやみなく降そふ雨のあしは物かは",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "二葉より今はおほたの松のはの幾よか君を戀てへぬらん",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "つらくのみみゆる君かな山のはに風まつ雲の定めなきよに",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "君戀と消こそわたれ山河にうつまく水のみなはならねと",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "我戀にたくひてやりしたましゐの返りとまつほとの久しさ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "戀そめし心をのみそ恨みつる人のつらさを我になしつゝ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "我戀はなからの橋の下よりもつくる世なくもなりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "我戀はいをなき淵の釣なれやうけも引れてやみぬへらなり",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "天のとの明くるやをしき庭とりの鳴ぬあしたもなくそ成ぬる",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "あふ〓とのなきつゝ歸るよな〓〓は板面ねにも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "なにふりて世に住の江の神もなし戀しき人の影もみえねは",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "戀しとは何をかいはん岩波にたくふみなはの消ぬはかりを",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "天の河かはへの霧の中わけてほのかにみえし月の戀しさ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "戀しくは河への霧の夜をこめて立かへらすそあかしはてまし",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "あな戀し雲間の月に人をみておもかけにのみそへるころ哉",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "獨ねにあまたの冬をへぬる哉身をひと霜に思ひおかれて",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "冬の夜の袖の氷のこりすまに戀しき時はれをのみそなく",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "物思ひてよにふる雪のわひしきはつもり〓〓て消ぬはかりそ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "白山の雪のした草我なれやしたにもえつゝ年をのみふる",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "忘るとは恨みさらなんはし鷹のとかへる山の椎はもみちす",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "淺しとは恨みさらなん綿津海のこふれはいとゝ沖になる身を",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "言のはをなけなる物と思ひせは何かは人のつらくしもあらん",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "難波かた汀の芦のおひ風に恨みてそふる人のこゝろを",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "つらけれと猶そ戀つる水無瀨河うけもひかれぬ身とはしる〓〓",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "足引の山のかけはし久しくもなげきこりつゝ渡りぬるかな",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "神なひの山のさは水君なれや淺ましくのみみえしわたれは",
   "kana": "",
   "speaker": "兼盛集",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "うへしより枝のみまさる歎とて賴めはもとに雨そふりける",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "見わたせは松のは白きよしの山いくよ積れる雪にかあるらむ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "君か代の數ともとらむきの國のしらゝの濵につめるいさこを",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "難波江に茂れる芦のめもはるに多くのよをは君にとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "すまの浦にあさりする海士の大方はかひあるよとそ思ふへらなる",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "朽もせぬなからのはしの橋柱久しき〓とのみえすもあるかな",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "まこもかるみつの御牧の駒の足の早くたのしき世をもみる哉",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "我妹子か家路ふみわけしかすかの渡り難くもおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "むさしのを霧のはれまに見渡せは行さき遠き心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "玉くしけふたむら山の月影は萬代をこそてらすへらなれ",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "よる波のかすをそしらすなりにける籬の島のまちかけれども",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ぬま水も氷にけらしこしかたの山路も今はたえやしぬらん",
   "kana": "",
   "speaker": "",
   "page": 333,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "あしたつのむれゐる末の松山はいくそかさねの千年なるらん",
   "kana": "",
   "speaker": "兼盛集",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "しら波ののとけき浦の姫松は千年の數そそひてみえける",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "此夏のうすき衣は行末のかさねてかゝるをりをたのまん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "なよ竹のよなかき杖をつきてこそ八百萬代の秋はかそへめ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "萬代の山にねさしゝはしめより君か杖にと見えにけらしも",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "万代のよゝのみとりも〓き哉これや千年のすめる水の色",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "千代をへて岩のうへなる鶴さへそ君か千年につたふへらなる",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "しらたつの天の原よりとひつるは遠き心を知れるなるへし",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "昔より扇つたふる袖なれば君か手にてそ萬代はへん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "君かへん萬代の數かそふれはたゝかたはしの千年なり鳬",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "濁りなく千世をかそへてすむ水に光をそふる秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "むらさきの雲とそ見ゆる月影に水の面てらす岸の秋はき",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "千年とそ草むらことに聞ゆなるこや松虫の聲にはあるらん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "萬代と天の空まて聞ゆるはよふかき松のしらへなりけり",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "みさこゐるあら浪に立波なれはたいらけく社我國はあれ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "澤水に花のかけみる芦たつの鳴音雲井にきこえさらめや",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "谷ふかくやく炭かまのけふりたに峯の雲とはならぬ物かは",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "年をへてたけもかはらぬ平松のあやしやいかてねもみてし哉",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "芦の屋のこやとしいはゝ津の國の難波の〓とかいはすあるへき",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "君かまたかけにもかけてみえは社夢にも人をみつとおもはめ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "思ふてふ事はいはても思ひ鳬つらきをいはてつらしともみし",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "ひたふるにいひもはなてそ世にふれは人憎からぬ物と社きけ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "君かやとひまありけりと聞しより風に成ても入らんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "故〓は春めきにけりよしの山みかさの原を霞こめたり",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "我宿に鶯いたく鳴なるは庭もはたらに花やちるらむ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "白妙の雪ふりやまぬ梅かえにけふそ鶯春となくなる",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "さほ姫のいろ染かくる靑柳を吹なみたしそ春のはつかせ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "夜とゝもにちらすもあらなん櫻花あかぬ心はいつかたゆへき",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "ひとへつゝ八重山吹はひらけなんほとへて匂ふ花とたのまん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "我ゆきて花みるはかり住吉の峯の藤波折なかさしそ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "あらしのみ寒き山への卯花は消め雪かとあやまたれつゝ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "太山出て夜半にや來つる時鳥曉かけて聲のきこゆる",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "夏ふかく成そしにける大あらきの森のした草なへて人かる",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "君こふる心のそらは天川かひなくて行月日なりけり",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "人しれずあふをまつまとこひしなは何にかへたる命とかいはん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "忍ふれと色に出にけり我戀は物や思ふと人のとふまて",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "あふ事のかたゐさりする綠子のたゝん月にもあはしとやする",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "雨やまぬ軒のした水かすしらす戀しき〓とのまさるころ哉",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "みつき物たえすそなふる東路のせたの長橋おともとゝろに",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "萬代をもちそさかへん近江なるおものゝ濵の海士のひつきは",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "岩の上の河せきあけて植し田の稻は萬代たえすうへにし",
   "kana": "",
   "speaker": "兼盛集",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "さゝ波のなからの山のなからへは久しかるへき君か御代かな",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "君か代をまちしもしるし大あらきの里の榮へをみるか樂しき",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "やす河の水底すみて鶴龜の萬代かねてあそふをそみる",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "いにしへもみすやありけん鏡山行末遠きとよのあかりは",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "鏡山やまひこたかくよはふ也世の榮ゆへきかけそみゆらし",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "世のとみはいはくら山におさめ置て萬代まてに君そつたへん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "とみゆかの枝まさり行君か代にあへる國人たのもしき哉",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "朝妻のみゐのこのかけしけり合て榮へ行世をみるかたのしき",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "おなしくや人の心もいのるらむ我思ふ〓とをあやまつな神",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "あさましく有明の月と出つれとひたかく人にみえもする哉",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "降雪に色もかはらてひく物をたれあを馬となつけそめけん",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "春立は子日をそする年をへて久しきことは松をひくとて",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "ひきつれて大宮人のきませれは春うれしくもおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "つまつきもなくて今年はかすさしつ醉ひさまたれて今日は歸りぬ",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "千早振神の社を尋つゝけふのためてふいのりをそする",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "ゑひにける我らは志らす綾もなしたかかつけたる罪にかある覽",
   "kana": "",
   "speaker": "",
   "page": 334,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "花すゝきほ末の露にそほちたる我衣手をぬきとるやたれ",
   "kana": "",
   "speaker": "兼盛集",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "足引の山路遠くや出つらん日高くみゆる望月のこま",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "市とのみいふそはかなき萬代をかひにそ我は急き出つる",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "よつの〓に思ふ心を調へつゝひきありけともしる人もなし",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "白雲の山へはるかに聞ゆるをなかと日高く出たちをする",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "なよ竹の末のよ遠きわたらひは市女も我もかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "さき〓〓にこりにし君かしひこひを何業しにか又はきませる",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "招かねと數多の人のすかた哉とみといふ物そたのしかりける",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "年をへて織つくすへき糸なれや棚機つめをやとひてし哉",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "旅人はすりもはたこも空しきを早くいましれ山のとれたち",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "澤水に老ぬるかけをみるたつの鳴音雲ゐにきこゆらんやは",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "春雨に雪けの水もそふ物をなとてたえぬるいつみなるらん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "つかふへきかすにをとゝむ淺間なるみたらし河の底にわく玉",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "怪しきは駿河の守といひしよのなとうと濵のうとくなるらむ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "うと濵の疎きにはあらす田子の浦の戀しからおを豫て習ふそ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "よこはしり清見か關の通路にいつといふ〓とはなかくとゝめつ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "關すへぬ空に心の通ひなは身をとゝめてもかひやなかるらん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "鶯の初音にけふはおとろきて春の山へにをりくらしてん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "梅かゝをたよりの風やつけつらん春めつらしき君かきませる",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "澤水に蛙の聲はおいにけりおそくやからん春のを山田",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "一年にふたゝひもこぬ春なれはいとなくけふは花をこそみれ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "浦なきに釣のをたれてくる我そいたくなたちそ沖つ白波",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "あら波のかけくる岸の遠けれは風まにけふそ舟渡りする",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "河風の吹くるかけにふきくすしはらふる事そすゝしかりける",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "棚機のあふ夕くれの衣糸を秋の尾花にいく〓へぬらん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "秋のゝにまねく尾花にはかられて狩にきつれとけふは暮しつ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "朝露に我そはちくる菊の花つみしもしるき心ちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "からにしき色みえまかふもみち葉のちる木の本は立うかり鳬",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "太山には嵐やいたく吹ぬらんあしろもたはに紅葉つもれり",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "奥山のゆつるはいかて折つらんあやめもしらぬ雪のふれるに",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "あたらしき年のはしめに逢くれと此春はかり樂しきはなし",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "人しれす待しもしるく鶯の聲めつらしき春にも有かな",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "足引の山かたつける家ゐにはまつ人さきに若菜をそつむ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "花みると家ちをおそくかへる哉待時すくと妹やなけかん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "色にあける年しなけれは櫻花けふ日くらしに折てこそみれ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "ときはなる花こそみゆる我宿の松に小高くさける藤なみ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "太山出るまつ初聲は時鳥我宿ちかくうちもなかなむ",
   "kana": "",
   "speaker": "兼盛集",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "我宿の庭の若草しけり合てなかめに日をもくらす比かな",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "水さむく風の凉しき我宿は夏といふ〓とはよそにこそきけ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "河風のすゝしからすはみな月のはらへはかりに物うからまし",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "大空のとゝはみれと棚機は衣きぬかしいくよへぬらん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "夜もすからみてをあかさん秋の月こよひの空に雲なからなん",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "時鳥聲めづらしく植し田をいなはもそよとけふはかるかな",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "をみなへし花みにきつる秋のゝをあやなくまれく尾花也けり",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "かくるへき木の葉なけれは神な月時雨に袖をぬらしてそ行",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "鴛のねのいたく鳴つる朝ほらけ池は氷にとちてけらしも",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "人しれす春をこそまて我宿に降つむ雪をはこふ人なみ",
   "kana": "",
   "speaker": "",
   "page": 335,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "まかきより木末をみつゝ梅花春のとなりにけふはきにけり",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "むれ立てめも春のゝに引松の千とせの春はたかためにそは",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "妻こふるきゝすの聲もたえなくにはかなくけふは家路暮しつ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "はかなくもけふは山路にくらす哉かへらむ程に花やちるとて",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "みちとせにひらくる桃の花盛りあまたの春は君のみそみん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "むらさきの雲うちなひく藤の花千年の松にかけてこそみれ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "けふくれはあすも來てみん梅花花ちるはかりふくな春風",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "花の木を植しもしるく春來れは我宿すきて行人もなし",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "世中にたのしき物は思ふとち花みてくらすこゝろなりけり",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "枝たはにやへ山吹は咲にけり井手の河へをおもひやる哉",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "一年は春なからにもくれなゝん花の盛をあくまてもみん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "引よせてまつこそたをれ藤の花またみぬ人にみせにやるとて",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "住吉の岸の藤波我宿の松の梢に色もまさらし",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "年每に棚機つめをいのりつゝおほくの秋を過しつるかな",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "棚機のあかぬわかれの悲しきにけふしもなとか君かきませる",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "來ぬ人をよひにはやらす我宿のまねく尾花にまかせてそみる",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "秋の夜の月みるとのみあかしつゝ今宵もねてや我はかへらん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "月影に鹿の音聞ゆ高砂の尾上の萩の花やらるらむ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "からくして急きかりつる山田哉いなおほせ鳥の後ろめたさに",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "足引の山田の梢あすまてといなおほせ鳥の思ふとたゆ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "かりにくる人はやとさす昔より都の事はゆかしけれとも",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "何にかは急きもゆかん夕暮にあすもこえなん山にやはあらぬ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "數ふれは我身につもる年月を送りむかふと何いそくらん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "日頃へて待しもしるく我宿の梅の梢に春は來にけり",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "靑柳のまゆにこもれる糸なれはくる春のみそ色まさりける",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "山里に家ゐせしより時鳥夜半の初音は我のみそきく",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "我駒をあやめの草に引そへてさつきもくれはみぬ時そなき",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "夏の日はすゝしかりけり河風ははらふる事もかくやなるらん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "殘りなく衣はかしつ棚機にけふもせなこは我いかにせん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "天川かはせの風に七夕も夜のふけ行をまちやわたらん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "はるかにそ花みにきつるをみなへしあたなる露に移ふなゆめ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "うかひする河へに年を送りつゝうき世中をしらてこそふれ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "207",
   "text": "春秋もしらて年ふる我身哉松と竹との年をかそへて",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "208",
   "text": "年をへて菊の下水みてしより花といふ〓としらて社ふれ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "209",
   "text": "戀しとはいへはさらなり水の上に降つむ雪と人はしらなん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "210",
   "text": "忘るやとなからへゆけと身にそへて戀しき〓とは遺れさりけり",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "211",
   "text": "まつ人を梢に高きなきさこそ風にわつらふ身ともなるらめ",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "212",
   "text": "思ふてふことのよにたにふりさらは我いへる〓と君にいはまし",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "213",
   "text": "大空にたな引雲のめに近くおりゐると見は我はたのまん",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "214",
   "text": "みちのくのあたちか原のしらま弓心つよくもみゆる君かな",
   "kana": "",
   "speaker": "",
   "page": 336,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
